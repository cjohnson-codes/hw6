def checkPrime(n):
    found = False

    for i in range(2, n):
        if n % i == 0:
            found = True

    return found

def main():
    n = int(input("Enter an integer: "))

    found = checkPrime(n)

    if found:
        print(n, "is NOT prime.")
    else:
        print(n, "is prime.")

main()